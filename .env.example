# Beacon Forge — environment configuration
# Copy to .env and fill in values for your deployment.

# --- Backend ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# SQLite database path (use a persistent volume in production)
DATABASE_URL=sqlite:///./data/beacon_forge.db

# API key for the local auth gate (used in demo mode).
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# --- Auth (Keycloak OIDC) — production identity ---
# Operator configures the Keycloak realm and endpoints.
OIDC_SERVER_URL=https://oidc.example/realms/beacon-forge
OIDC_CLIENT_ID=beacon-forge
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:5173/callback

# --- LLM (optional, opt-in, advisory) ---
# Set LLM_API_KEY to enable advisory LLM explanations on goal timelines.
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# --- Frontend ---
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
VITE_API_URL=http://127.0.0.1:8000
VITE_API_KEY=